# Chiavi personali, tutte facoltative e tutte gratuite. Senza, Sestante funziona con le sole fonti libere.
# Copia questo file in .env (o, col servizio di sistema, in /etc/sestante/sestante.env) e tienilo privato.
# Restano sul server: il browser non le vede mai.

# Copernicus Data Space: immagini e statistiche Sentinel-1 e Sentinel-2.
# https://dataspace.copernicus.eu → User settings → OAuth clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA Earthdata: laser GEDI e rilievo NASADEM. Il token dura 60 giorni.
# https://urs.earthdata.nasa.gov → Generate Token
NASA_EARTHDATA_TOKEN=

# NASA FIRMS: incendi attivi.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# OpenWeather: meteo e qualità dell'aria correnti.
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
